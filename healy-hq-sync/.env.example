# Google Keep Credentials
# Your Gmail address
GOOGLE_EMAIL=your-email@gmail.com

# Your Gmail password (or app-specific password if 2FA is enabled)
# WARNING: Store this securely. Consider using an app password instead of your main password.
# See: https://support.google.com/accounts/answer/185833
GOOGLE_PASSWORD=your-app-specific-password

# Notion API Credentials
# Get your API key from: https://www.notion.com/my-integrations
# Create a new internal integration, copy the "Internal Integration Token"
NOTION_API_KEY=secret_xxxxx...

# Your Notion Database ID (the Idea Inbox database)
# Get from the URL: https://notion.so/username/[THIS-PART]?v=xxx
# It's the long alphanumeric string after /username/
NOTION_DATABASE_ID=12345678abcd...
